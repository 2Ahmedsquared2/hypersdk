# Hyperliquid SDK Environment Configuration
# Copy this file to .env and add your actual values
# NEVER commit .env with real credentials!

# Your wallet's private key (64 hex chars without 0x prefix, or with 0x prefix)
# This is your AGENT wallet key for code-only signing (no Phantom required)
# Get testnet funds: https://app.hyperliquid-testnet.xyz/faucet
PRIVATE_KEY=your_private_key_here_64_hex_characters

# Alternative: Use a Foundry keystore instead of PRIVATE_KEY
# Run examples with: cargo run --example send_order -- --keystore my_wallet
# Keystores are stored in ~/.foundry/keystores/
